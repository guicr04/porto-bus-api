{
  "name": "porto-bus-api",
  "version": "0.1.0",
  "description": "A personal wrapper API around Porto's STCP bus system.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --experimental-sqlite src/index.js",
    "dev": "node --experimental-sqlite --watch src/index.js",
    "test": "node --experimental-sqlite --test \"test/*.test.js\"",
    "gtfs:refresh": "node --experimental-sqlite scripts/gtfs-refresh.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
