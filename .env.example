# Server
PORT=8000

# --- Official static GTFS feed (Porto open data) ---
# The newest feed is resolved automatically from the portal's CKAN API, because
# the dataset publishes a new resource (new UUID) every few days — any pinned
# URL eventually 404s. Leave GTFS_URL unset unless you want to pin a specific
# feed or point at a local file.
# GTFS_URL=
GTFS_PORTAL_BASE=https://opendata.porto.digital
GTFS_DATASET_ID=horarios-paragens-e-rotas-em-formato-gtfs-stcp
# Daily. The feed's own validity window is ~18 days and the portal republishes
# every 2-3 days, so a weekly TTL can leave the store holding an expired
# timetable. The server refreshes at boot when the store is older than this.
GTFS_TTL_SECONDS=86400

# Where the static store lives. A derived artifact — safe to delete; rebuild
# with `make gtfs`. In a container this wants to be on a mounted volume so a
# restart doesn't re-download the feed.
DB_PATH=data/gtfs.db

# --- Modern stcp.pt public JSON API ---
STCP_API_BASE=https://stcp.pt/api

# Cache live arrivals for this long. The departure board polls a dozen stops and
# an always-on display refreshes constantly, so this keeps traffic to stcp.pt
# reasonable. Set to 0 to disable.
REALTIME_TTL_MS=15000

# --- Departure board (the desk display) ---
# Where the display sits. Find the coordinates for an address once with:
#   make geocode ADDRESS="Rua de Santa Catarina 100, Porto"
# Coordinates rather than an address on purpose — the board is polled constantly,
# and geocoding every poll would hammer a third party for an unchanging answer.
# HOME_LAT=41.147223
# HOME_LON=-8.616926
HOME_LABEL=HOME

# Identify ourselves politely. If stcp.pt ever blocks this, set a browser-like
# User-Agent string here instead.
USER_AGENT=porto-bus-api/0.1 (personal project)

HTTP_TIMEOUT_MS=10000
